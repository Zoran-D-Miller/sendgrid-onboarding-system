# Copy to .env and fill in. .env is git-ignored; never commit real values.
# See docs/INTEGRATION.md section 8 for what each variable does.

# Restricted API key. This take-home uses one key with Mail Send, Template Engine
# and Suppressions (for npm run deploy). Production splits it: the service gets
# Mail Send only; CI gets Template Engine only, for deploys.
SENDGRID_API_KEY=

# Dynamic template IDs (start with d-)
SENDGRID_TEMPLATE_T1=
SENDGRID_TEMPLATE_T2=
SENDGRID_TEMPLATE_T3=

# Unsubscribe group ID for "Onboarding"
SENDGRID_ASM_GROUP_ONBOARDING=

# Verified sender used as "from" (Single Sender in a trial account)
SENDGRID_FROM_EMAIL=

# Event Webhook signature public key (from the webhook's Edit dialog)
SENDGRID_WEBHOOK_PUBLIC_KEY=

# HMAC secret shared with the platform for the signup webhook
SIGNUP_WEBHOOK_SECRET=

# true everywhere except production: SendGrid validates, delivers nothing
SENDGRID_SANDBOX=true
